# Ignore rules for Dockerfile.private (self-hosted / private registry build).
# Mirrors the upstream .dockerignore and additionally drops local runtime
# state, IDE metadata and the codegraph/omo symlink targets.
.github
.git
*.md
.vscode
.idea
.gitignore
Makefile
docs
.eslintcache
.gocache
codegraph
.codegraph
.omo
/data
/logs
/electron/node_modules
/web/node_modules
/web/dist
!THIRD-PARTY-LICENSES.md

buildkitd.toml

# Never let deployment secrets enter the build context: the Go stage runs
# `COPY . .`, so an env file with real credentials would end up in a layer.
docker/env.production
docker/.env.production
.env.production
